{
  "id": "pronunciation",
  "title": "发音专题",
  "intent": "分开练习音的长短、停顿、鼻音、高低音调和句子语调。",
  "lessons": [
    {
      "id": "p01",
      "title": "元音、清音和浊音",
      "intent": "先把短音读清楚，再比较两点和小圆圈。",
      "sections": [
        {
          "title": "五个元音",
          "paragraphs": [
            "先听「あ・い・う・え・お」。日语「う」通常不像中文“乌”那样明显圆唇；不要用中文谐音固定口型。短音保持短，不能每个音都拖长。"
          ]
        },
        {
          "title": "清浊区别",
          "paragraphs": [
            "「か／が」「た／だ」不是同一音。「は／ば／ぱ」也要分别听。两点和小圆圈会改变读音，学词时把这些符号一起看。"
          ]
        }
      ],
      "examples": [
        {
          "text": "う",
          "reading": "う",
          "translation": "元音 u",
          "audioId": "k-0-う"
        },
        {
          "text": "か",
          "reading": "か",
          "translation": "清音 ka",
          "audioId": "k-0-か"
        },
        {
          "text": "が",
          "reading": "が",
          "translation": "浊音 ga",
          "audioId": "k-0-が"
        },
        {
          "text": "は",
          "reading": "は",
          "translation": "清音 ha",
          "audioId": "k-0-は"
        },
        {
          "text": "ば",
          "reading": "ば",
          "translation": "浊音 ba",
          "audioId": "k-0-ば"
        },
        {
          "text": "ぱ",
          "reading": "ぱ",
          "translation": "半浊音 pa",
          "audioId": "k-0-ぱ"
        }
      ],
      "practice": [
        "先单独听，再把「か／が」交替跟读。",
        "用较小音量练习「は／ば／ぱ」，留意嘴唇和出声方式。"
      ],
      "pitfalls": [
        "声音更大不等于浊音。",
        "中文拼音只是近似提示，最终以日语发音为参照。"
      ],
      "questions": [
        {
          "prompt": "「は」加小圆圈后变成？",
          "options": [
            "ば",
            "ぱ",
            "が"
          ],
          "answer": 1,
          "explanation": "小圆圈形成「ぱ」。"
        },
        {
          "prompt": "怎样比较「か／が」？",
          "options": [
            "当作同一音",
            "分别听读并看清两点",
            "把其中一个拖长即可"
          ],
          "answer": 1,
          "explanation": "清音和浊音有读音区别。"
        }
      ],
      "sources": [
        {
          "title": "东京外国语大学：母音",
          "url": "https://www.coelang.tufs.ac.jp/mt/ja/pmod/practical/01-07-01.php"
        },
        {
          "title": "东京外国语大学：清浊 k / g",
          "url": "https://www.coelang.tufs.ac.jp/mt/ja/pmod/practical/01-06-01.php"
        }
      ]
    },
    {
      "id": "p02",
      "title": "拗音：きゃ与きや",
      "intent": "看小写假名，避免多读一拍。",
      "sections": [
        {
          "title": "两个字合成一拍",
          "paragraphs": [
            "「きゃ・きゅ・きょ」等拗音虽然写两个假名，发音合成一拍。「きや」使用大写「や」，读成「き・や」两拍。"
          ]
        },
        {
          "title": "词里听区别",
          "paragraphs": [
            "「病院」读「びょういん」，「美容院」读「びよういん」。差别先看「びょ」和「び・よ」，再保留后面的长音。"
          ]
        }
      ],
      "examples": [
        {
          "text": "病院",
          "reading": "びょういん",
          "translation": "医院",
          "audioId": "w076",
          "note": "びょ是一个整体。",
          "beats": [
            "びょ",
            "う",
            "い",
            "ん"
          ]
        },
        {
          "text": "美容院",
          "reading": "びよういん",
          "translation": "美发店",
          "audioId": "w628",
          "note": "び、よ分开。",
          "beats": [
            "び",
            "よ",
            "う",
            "い",
            "ん"
          ]
        },
        {
          "text": "きゃ",
          "reading": "きゃ",
          "translation": "拗音 kya",
          "audioId": "k-hira-きゃ"
        }
      ],
      "practice": [
        "交替听「病院／美容院」，分别数四拍和五拍。",
        "把「きゃ」一次说出，不插入明显的 i 音。"
      ],
      "pitfalls": [
        "不要把小写「ゃ」变成独立的「や」。",
        "拗音之后仍可能接长音，不是所有两字组合都只有一拍。"
      ],
      "questions": [
        {
          "prompt": "「きゃ」有几拍？",
          "options": [
            "一拍",
            "两拍",
            "三拍"
          ],
          "answer": 0,
          "explanation": "小写「ゃ」与前面假名合成一拍。"
        },
        {
          "prompt": "「びよういん」表示？",
          "options": [
            "医院",
            "美发店",
            "车站"
          ],
          "answer": 1,
          "explanation": "「びよういん」是美容院；病院读「びょういん」。"
        }
      ],
      "sources": [
        {
          "title": "东京外国语大学：拗音",
          "url": "https://www.coelang.tufs.ac.jp/mt/ja/pmod/practical/01-11-01.php"
        }
      ]
    },
    {
      "id": "p03",
      "title": "音拍：长音、っ、ん都占时间",
      "intent": "先数拍，再把词连起来读。",
      "sections": [
        {
          "title": "用拍理解节奏",
          "paragraphs": [
            "初学可以用轻敲手指帮助数拍：一般假名各一拍，拗音合成一拍，长音延长部分、促音「っ」、拨音「ん」各占一拍。"
          ]
        },
        {
          "title": "数拍后恢复自然速度",
          "paragraphs": [
            "「きょう」是「きょ／う」两拍；「きって」是「き／っ／て」三拍。数拍用于找回漏掉的时长，真正说话时不要把每拍切成孤立的音。"
          ]
        }
      ],
      "examples": [
        {
          "text": "今日",
          "reading": "きょう",
          "translation": "今天",
          "audioId": "w182",
          "note": "「きょ」合成一拍，后面的「う」延长元音。",
          "beats": [
            "きょ",
            "う"
          ]
        },
        {
          "text": "切手",
          "reading": "きって",
          "translation": "邮票",
          "audioId": "w463",
          "note": "中间的小「っ」也占一拍。",
          "beats": [
            "き",
            "っ",
            "て"
          ]
        },
        {
          "text": "新聞",
          "reading": "しんぶん",
          "translation": "报纸",
          "audioId": "w055",
          "note": "两个「ん」分别保留时长。",
          "beats": [
            "し",
            "ん",
            "ぶ",
            "ん"
          ]
        }
      ],
      "practice": [
        "轻敲两次说「きょう」，三次说「きって」。",
        "最后放下手指，按完整词跟读。"
      ],
      "pitfalls": [
        "不是按汉字数量数拍，也不能按所有印刷字符机械数拍。",
        "自然语流的各拍时长会有变化，数拍是练习方法。"
      ],
      "questions": [
        {
          "prompt": "「きょう」应怎样数？",
          "options": [
            "き／よ／う，三拍",
            "きょ／う，两拍",
            "全部一拍"
          ],
          "answer": 1,
          "explanation": "「きょ」一拍，长音延长部分再占一拍。"
        },
        {
          "prompt": "「きって」的小「っ」是否占时间？",
          "options": [
            "占一拍",
            "直接跳过",
            "读成完整的「つ」"
          ],
          "answer": 0,
          "explanation": "促音占一拍，但不是正常的「つ」。"
        }
      ],
      "sources": [
        {
          "title": "东京外国语大学：拍感覚基础",
          "url": "https://www.coelang.tufs.ac.jp/mt/ja/pmod/practical/01-10-01.php"
        }
      ]
    },
    {
      "id": "p04",
      "title": "长音：把元音延长一拍",
      "intent": "练习元音的长短，避免改变词义。",
      "sections": [
        {
          "title": "多一拍，意思可能不同",
          "paragraphs": [
            "长音是在保持元音音质的同时延长。不要通过突然加大音量代替长度。「おばさん」是阿姨，「おばあさん」是奶奶或老奶奶，长短会影响意思。"
          ]
        },
        {
          "title": "写法不只有长横线",
          "paragraphs": [
            "片假名常用「ー」，如「コーヒー」。平假名中「おとうさん」的「とう」通常读长 o；「せんせい」的「せい」常读长 e。不能见到所有「おう／えい」都机械合并，词边界、词形和实际读法仍要具体确认。"
          ]
        }
      ],
      "examples": [
        {
          "text": "コーヒー",
          "reading": "こーひー",
          "translation": "咖啡",
          "audioId": "w123",
          "note": "こ／ー／ひ／ー，共四拍。",
          "beats": [
            "こ",
            "ー",
            "ひ",
            "ー"
          ]
        },
        {
          "text": "おばあさん",
          "reading": "おばあさん",
          "translation": "奶奶；老奶奶",
          "audioId": "w304",
          "note": "延长「あ」，不额外加一个喉部停顿。",
          "beats": [
            "お",
            "ば",
            "あ",
            "さ",
            "ん"
          ]
        },
        {
          "text": "お父さん",
          "reading": "おとうさん",
          "translation": "爸爸；对方的父亲",
          "audioId": "w095",
          "note": "「とう」中的 o 延长。",
          "beats": [
            "お",
            "と",
            "う",
            "さ",
            "ん"
          ]
        },
        {
          "text": "先生",
          "reading": "せんせい",
          "translation": "老师",
          "audioId": "w006",
          "note": "「せい」常读长 e。",
          "beats": [
            "せ",
            "ん",
            "せ",
            "い"
          ]
        }
      ],
      "practice": [
        "听「コーヒー」，保留两个延长部分的时长。",
        "比较文字「おばさん／おばあさん」，再跟读有音频的「おばあさん」。"
      ],
      "pitfalls": [
        "长音不是重读，也不是把每个元音都拉长。",
        "「ー」延长前一个元音，不固定读某一个音。"
      ],
      "questions": [
        {
          "prompt": "「コーヒー」的「ー」主要表示什么？",
          "options": [
            "加大音量",
            "延长前面的元音",
            "读「ん」"
          ],
          "answer": 1,
          "explanation": "长音的关键是延长时长。"
        },
        {
          "prompt": "「おばあさん」的长音在哪里？",
          "options": [
            "ば后的「あ」",
            "さん后的停顿",
            "没有长音"
          ],
          "answer": 0,
          "explanation": "「ばあ」保留长 a，和「おばさん」区别。"
        }
      ],
      "sources": [
        {
          "title": "东京外国语大学：长音",
          "url": "https://www.coelang.tufs.ac.jp/mt/ja/pmod/practical/02-02-01.php"
        }
      ]
    },
    {
      "id": "p05",
      "title": "促音：小っ与停顿",
      "intent": "在后一个辅音前留出一拍。",
      "sections": [
        {
          "title": "小っ不是小声的つ",
          "paragraphs": [
            "「きって」中先说「き」，准备发「て」时先保持阻塞，再放开。这个时段相当于一拍，不要读成「きつて」。"
          ]
        },
        {
          "title": "不一定是完全静音",
          "paragraphs": [
            "遇到 s 一类摩擦音，促音可表现为摩擦持续，如「ざっし」。所以练习重点是让后一个辅音更长，不能所有词都插入一个生硬的空白。"
          ]
        }
      ],
      "examples": [
        {
          "text": "切手",
          "reading": "きって",
          "translation": "邮票",
          "audioId": "w463",
