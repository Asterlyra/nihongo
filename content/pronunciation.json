        {
          "text": "学校",
          "reading": "がっこう",
          "translation": "学校",
          "audioId": "w016",
          "note": "在「こ」前保留促音。",
          "beats": [
            "が",
            "っ",
            "こ",
            "う"
          ]
        },
        {
          "text": "ゆっくり",
          "reading": "ゆっくり",
